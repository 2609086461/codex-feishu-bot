COMPOSE_PROJECT_NAME=codex-feishu-bot-real

# 对外暴露给宿主机的 app 端口
APP_PORT=3000
TZ=Asia/Shanghai
# Docker 内 /workspace 对应的宿主机工作目录。不要把整个仓库根目录挂进去
CODEX_WORKSPACE_HOST_PATH=.codex-local/workspace
# 容器内默认导出产物目录，位于运行时工作目录里
CODEX_ARTIFACTS_DIR=/workspace/artifacts
# 运行态快照文件，和工作目录一起持久化
RUNTIME_STATE_FILE=/workspace/.codex-feishu-bot/runtime-state.json
# 飞书消息更新的防抖窗口，调试时可压低
LIVE_UPDATE_DEBOUNCE_MS=1200

# 飞书区域，一般保持 feishu
FEISHU_DOMAIN=feishu
# 由 Codex 通过飞书开放平台自动化配置后写回
FEISHU_APP_ID=
# 由 Codex 通过飞书开放平台自动化配置后写回
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
MAIN_TABLE_ID=
FEISHU_VERIFICATION_TOKEN=
# 必填：仅允许这些飞书用户触发 Codex，多个 open_id 用英文逗号分隔
FEISHU_ALLOWED_OPEN_IDS=
# 默认只处理私聊。确认需要群聊后再改为 true
FEISHU_ALLOW_GROUP_MESSAGES=false

# 运行时 Codex worker 模型，可按需调整
CODEX_APP_SERVER_MODEL=gpt-5.6-luna
CODEX_CLI_VERSION=0.157.1

# 认证方式二选一。
# 1. 推荐：把宿主机已有的 ~/.codex 挂进容器，写宿主机绝对路径
CODEX_HOME_SOURCE=codex-home
GIT_SSH_HOST_PATH=.codex-local/ssh
MAIL_SECRETS_HOST_PATH=.codex-local/mail
QQ_MAIL_ADDRESS=your-account@qq.com
QQ_MAIL_AUTH_CODE_FILE=/run/secrets/codex-mail/qq-imap-auth-code

# 可选：小红书 MCP。必须先按 docs/xiaohongshu-mcp.md 在宿主机部署独立服务，
# 再启用；令牌只保存在私有 .env.real，绝不能提交到 Git。
XHS_MCP_ENABLED=false
XHS_MCP_URL=http://xiaohongshu-mcp:18060/mcp
XHS_MCP_NETWORK=codex-feishu-xhs
XHS_MCP_AUTH_TOKEN=
# 2. 或者填 OPENAI_API_KEY，容器首次启动时会自动 codex login
OPENAI_API_KEY=
