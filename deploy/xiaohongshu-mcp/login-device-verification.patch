+// isLoggedIn combines the historical sidebar selector with authenticated user
+// state. The latter prevents false negatives when Xiaohongshu changes its DOM.
+func (a *LoginAction) isLoggedIn(page *rod.Page) (bool, error) {
+	exists, _, err := page.Has(`.main-container .user .link-wrapper .channel`)
 	if err != nil {
 		return false, errors.Wrap(err, "check login status failed")
 	}
-
-	if !exists {
-		return false, errors.Wrap(err, "login status element not found")
+	if exists {
+		return true, nil
 	}
 
-	return true, nil
+	res, err := page.Eval(`() => {
+		const unwrap = value => {
+			if (!value || typeof value !== "object") return value;
+			if (value.value !== undefined) return value.value;
+			if (value._value !== undefined) return value._value;
+			return value;
+		};
+		const user = window.__INITIAL_STATE__ && window.__INITIAL_STATE__.user;
+		const candidates = user ? [user.userInfo, user.currentUser, user.me] : [];
+		const info = candidates.map(unwrap).find(value => value && typeof value === "object");
+		return Boolean(info && info.guest !== true && (info.userId || info.user_id || info.nickname));
+	}`)
+	if err != nil {
+		return false, errors.Wrap(err, "read login page state failed")
+	}
+	return res.Value.Bool(), nil
 }
 
