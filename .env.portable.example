# Copy to .env.portable. This file contains private credentials after editing.
COMPOSE_PROJECT_NAME=codex-feishu-bot-portable
APP_PORT=3000
TZ=Asia/Shanghai
CODEX_CLI_VERSION=0.162.1
CODEX_APP_SERVER_MODEL=auto

# Reuse an existing Feishu app configured for WebSocket long connection.
FEISHU_DOMAIN=feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
MAIN_TABLE_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOW_GROUP_MESSAGES=false

# Leave empty if signing in with `codex login --device-auth` in the container.
# Never commit this file or include it in the Docker build context.
OPENAI_API_KEY=

# Optional. Put actual secrets under .portable-data/mail and .portable-data/speech.
QQ_MAIL_ADDRESS=your-account@qq.com
